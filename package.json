{
  "name": "sidelineos-plugin-video",
  "private": true,
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist .bundle sideline-plugin-v1.tar.gz sideline-plugin-v1.tar.gz.sha256",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "package:plugin": "rm -rf .bundle && mkdir -p .bundle && cp plugin.manifest.json .bundle/ && cp -r dist .bundle/dist && if [ -d migrations ]; then cp -r migrations .bundle/migrations; fi && tar -czf sideline-plugin-v1.tar.gz -C .bundle . && sha256sum sideline-plugin-v1.tar.gz > sideline-plugin-v1.tar.gz.sha256 && rm -rf .bundle"
  },
  "peerDependencies": {
    "@sidelineos/plugin-sdk": "^1.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.546.0"
  },
  "devDependencies": {
    "@sidelineos/plugin-sdk": "https://github.com/moritztw/SidelineOS-core/releases/download/v0.1.0-alpha.1/sidelineos-plugin-sdk-1.0.0.tgz",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
